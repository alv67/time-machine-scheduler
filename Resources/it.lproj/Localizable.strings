"help.subtitle" = "Pianificazione dei backup di Time Machine";

"help.schedule.title" = "Pianificazione";
"help.schedule.1" = "Scegli l'ora di avvio e i giorni, poi premi «Salva pianificazione». L'installazione del daemon richiede la password di amministratore.";
"help.schedule.2" = "Se Time Machine ha una frequenza automatica attiva, il banner in alto apre le Impostazioni di Sistema: scegli «Manualmente» per evitare backup doppi.";

"help.options.title" = "Opzioni";
"help.options.1" = "«Avvia solo se la destinazione è raggiungibile» controlla l'host della destinazione configurata in Time Machine (letta da tmutil), non un indirizzo fisso.";
"help.options.2" = "«Impedisci il sonno» usa caffeinate -i durante il backup.";
"help.options.3" = "«Salta se il Mac è a batteria» evita il backup quando il Mac non è collegato alla corrente.";
"help.options.4" = "«Notifica a fine backup» mostra una notifica di sistema.";

"help.backup.title" = "Backup e log";
"help.backup.1" = "«Backup ora» avvia subito un backup fuori pianificazione.";
"help.backup.2" = "Il log mostra gli ultimi 200 eventi e ruota automaticamente a 1 MB (3 file).";

"help.restore.title" = "Ripristino";
"help.restore.1" = "«Ripristina…» rimuove daemon, script e log e riporta Time Machine alla frequenza scelta. Se macOS non applica la modifica, l'app apre le Impostazioni e lo segnala.";

"help.limits.title" = "Limiti";
"help.limits.1" = "Un Mac spento non può essere acceso da nessuna pianificazione (Apple Silicon).";
"help.limits.2" = "caffeinate non impedisce il sonno con il coperchio chiuso.";
"help.limits.3" = "La finestra dell'app può essere chiusa: il daemon continua a funzionare.";
"help.limits.4" = "Mentre il Mac è sbloccato il daemon tiene un'asserzione sul keybag tramite un framework privato di macOS: se Apple la rimuove, i backup avviati a schermo bloccato tornano a fallire (il log lo segnala).";
"help.limits.5" = "Se il Mac è spento o in sleep all'orario previsto il backup non viene recuperato al risveglio: si aspetta il prossimo orario pianificato.";

