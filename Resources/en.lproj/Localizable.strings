/* Help */
"help.subtitle" = "Scheduling Time Machine backups";

"help.schedule.title" = "Scheduling";
"help.schedule.1" = "Choose the start time and weekdays, then click “Save schedule”. Installing the daemon requires the administrator password.";
"help.schedule.2" = "If Time Machine has an automatic schedule enabled, the banner at the top opens System Settings: choose “Manually” to avoid duplicate backups.";

"help.options.title" = "Options";
"help.options.1" = "“Start only if the destination is reachable” checks the host of the destination configured in Time Machine (read via tmutil), not a fixed address.";
"help.options.2" = "“Prevent sleep” uses caffeinate -i during the backup.";
"help.options.3" = "“Skip when the Mac is on battery” avoids backups while the Mac is not connected to power.";
"help.options.4" = "“Notify when backup ends” shows a system notification.";

"help.backup.title" = "Backup and log";
"help.backup.1" = "“Back up now” starts a backup immediately, outside the schedule.";
"help.backup.2" = "The log shows the last 200 events and rotates automatically at 1 MB (3 files).";

"help.restore.title" = "Restore";
"help.restore.1" = "“Restore…” removes the daemon, script and log and returns Time Machine to the selected frequency. If macOS does not apply the change, the app opens Settings and reports it.";

"help.limits.title" = "Limitations";
"help.limits.1" = "A powered-off Mac cannot be woken by any schedule (Apple Silicon).";
"help.limits.2" = "caffeinate does not prevent sleep with the lid closed.";
"help.limits.3" = "The app window can be closed: the daemon keeps running.";
"help.limits.4" = "While the Mac is unlocked the daemon holds a keybag assertion through a private macOS framework: if Apple removes it, backups that start with the screen locked fail again (the log says so).";
"help.limits.5" = "If the Mac is off or asleep at the scheduled time the backup is not caught up on wake: it waits for the next scheduled time.";

